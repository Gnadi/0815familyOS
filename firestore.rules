rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared membership lookup. The per-collection familyMembers() helpers
    // further down stay as they are; this one serves families and invites.
    function membersOf(database, fid) {
      return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
    }

    // A user may read their own document, or any document belonging to a
    // member of the same family (needed to resolve member display names).
    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId != null &&
          uid in get(/databases/$(database)/documents/families/$(
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId
          )).data.memberIds
        )
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Families.
    //
    // READ is split: `get` is members-only, `list` is denied outright. The
    // family document holds `encryptionKeyJwk` — the AES-256-GCM key for the
    // document vault — so the previous unconditional read let any signed-in
    // account enumerate /families and walk away with every family's vault key.
    // Nothing in the client lists this collection any more; joining goes
    // through /invites/{token} below.
    //
    // Known residual weakness, deliberately out of scope: a *member* can still
    // overwrite encryptionKeyJwk or remove other members. Closing that needs a
    // role model the app does not have.
    match /families/{familyId} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // Join. A non-member may add EXACTLY themselves and nothing else, and
      // only while holding a live invite token that targets THIS family.
      //
      // The set arithmetic is load-bearing: hasOnly(['memberIds']) on its own
      // let a joiner REPLACE the array and evict every existing member.
      //
      // The matches() guard keeps attacker-controlled text out of the
      // interpolated document path below.
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberIds', 'lastJoinToken'])
        && request.resource.data.memberIds.toSet()
             .difference(resource.data.memberIds.toSet()).size() == 1
        && resource.data.memberIds.toSet()
             .difference(request.resource.data.memberIds.toSet()).size() == 0
        && request.resource.data.lastJoinToken is string
        && request.resource.data.lastJoinToken.matches('^[A-Za-z0-9_-]{16,64}$')
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinToken))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinToken))
             .data.familyId == familyId
        && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinToken))
             .data.revoked == false
        && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinToken))
             .data.expiresAt > request.time;
    }

    // Invites. The document ID *is* the secret, so:
    //   - `get` is allowed to any signed-in user (you must already hold the
    //     token to name the document), and
    //   - `list` is denied, because enumeration would turn every token into a
    //     free pass into every family.
    // Tokens are 128-bit CSPRNG values (src/utils/inviteToken.js).
    //
    // Note: a use COUNTER is deliberately absent. Enforcing "single use" would
    // need an atomic increment here in the same transaction as the family
    // update, across two collections — not expressible in rules. Expiry and
    // explicit revocation are, and both are enforced server-side.
    match /invites/{token} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid in membersOf(database, request.resource.data.familyId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.familyId is string
        && request.resource.data.familyName is string
        && request.resource.data.revoked == false
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(31, 'd');

      // Revoke only. familyId / expiresAt / createdBy are immutable, so a
      // token can never be re-pointed at another family or extended.
      allow update: if request.auth != null
        && request.auth.uid in membersOf(database, resource.data.familyId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['revoked', 'revokedAt'])
        && request.resource.data.revoked == true;

      allow delete: if request.auth != null
        && request.auth.uid in membersOf(database, resource.data.familyId);
    }

    // Events belong to a family; only family members may read/write them.
    match /events/{eventId} {
      function familyMembers(fid) {
        return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
      }
      allow read: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
      allow create: if request.auth != null
        && request.auth.uid in familyMembers(request.resource.data.familyId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
    }

    // Tasks mirror the events rule: only members of the owning family may
    // read or mutate them, and creation must identify the caller.
    match /tasks/{taskId} {
      function familyMembers(fid) {
        return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
      }
      allow read: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
      allow create: if request.auth != null
        && request.auth.uid in familyMembers(request.resource.data.familyId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
    }

    // Gifts: only family members may read or mutate. No userId check on
    // create because gifts have no author field.
    match /gifts/{giftId} {
      function familyMembers(fid) {
        return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
      }
      allow read: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
      allow create: if request.auth != null
        && request.auth.uid in familyMembers(request.resource.data.familyId);
      allow update, delete: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
    }

    // Document Vault (documents and trophies). Mirrors the tasks rule.
    match /documents/{documentId} {
      function familyMembers(fid) {
        return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
      }
      allow read: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
      allow create: if request.auth != null
        && request.auth.uid in familyMembers(request.resource.data.familyId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
    }

    // Shopping list: shared per family, every member may read/write.
    match /shoppingItems/{itemId} {
      function familyMembers(fid) {
        return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
      }
      allow read: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
      allow create: if request.auth != null
        && request.auth.uid in familyMembers(request.resource.data.familyId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
    }

    // Recipes: shared per family, every member may read/write. Mirrors the
    // shopping list rule (create must identify the caller).
    match /recipes/{recipeId} {
      function familyMembers(fid) {
        return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
      }
      allow read: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
      allow create: if request.auth != null
        && request.auth.uid in familyMembers(request.resource.data.familyId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
    }

    // Meal plan entries: shared per family, every member may read/write.
    match /mealPlanEntries/{entryId} {
      function familyMembers(fid) {
        return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
      }
      allow read: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
      allow create: if request.auth != null
        && request.auth.uid in familyMembers(request.resource.data.familyId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
    }

    // Vaccinations: only family members may read or write records.
    // Each record is tied to a kidId (child within the family) and the
    // creating user. Any family member can edit or delete any record so
    // both parents can manage the children's health data together.
    match /vaccinations/{vaccinationId} {
      function familyMembers(fid) {
        return get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
      }
      allow read: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
      allow create: if request.auth != null
        && request.auth.uid in familyMembers(request.resource.data.familyId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kidId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if request.auth != null
        && request.auth.uid in familyMembers(resource.data.familyId);
    }
  }
}
