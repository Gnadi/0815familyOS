# Firebase (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public origin of this deployment. Set it on any host that is not
# myfaos.app: the pairing-token URLs in Settings -> Voice shortcuts are built
# from it, so a wrong value hands out a URL that points at the wrong domain.
VITE_SITE_URL=

# Cloudinary (reserved for future image features; not used in MVP)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Voice assistant / chatbot (optional; server-side only, never VITE_*)
# One provider key is enough. See docs/assistant-integration.md.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Which one to use, if several keys are present: gemini | openai | anthropic
# ASSISTANT_PROVIDER=
# Override the default model (gemini-2.5-flash / gpt-4o-mini / claude-haiku-4-5-20251001)
# ASSISTANT_MODEL=
# Any OpenAI-compatible gateway (Groq, OpenRouter, Azure, local Ollama)
# ASSISTANT_BASE_URL=
# Required so the endpoint can verify who is calling it (falls back to
# VITE_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=

# Only needed for the chatbot/shortcut interface (/api/mcp, /api/agent), which
# writes without a browser session: the service-account JSON from
# "Firebase console -> Project settings -> Service accounts", raw or base64.
# FIREBASE_SERVICE_ACCOUNT=
