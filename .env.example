# Firebase (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — required for Document Vault attachments. Files are encrypted in
# the browser before upload. Leave empty to run without attachments.
VITE_CLOUDINARY_CLOUD_NAME=

# Server-side only (Vercel env), for api/cloudinary-sign.js and
# api/cloudinary-destroy.js. Never expose these to the client.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Also server-side. cloudinary-destroy.js verifies the caller's session and
# reads the owning document as them before deleting a file, so it needs these.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
