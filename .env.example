# Firebase (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (optional). The public half of the VAPID key pair used by the
# reminder sender (.github/workflows/reminders.yml). Without it, reminders
# only arrive while the app is open. Generate a pair with:
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Cloudinary (reserved for future image features; not used in MVP)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
