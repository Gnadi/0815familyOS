{
  "rewrites": [
    {
      "source": "/join/:token",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^de(-[A-Za-z]{2,8})?([,;].*)?$"
        }
      ],
      "destination": "/join.de.html"
    },
    { "source": "/join/:token", "destination": "/join.html" },
    { "source": "/((?!assets/|api/).*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(icons|screenshots)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/((?!assets/|api/|fonts/|icons/|screenshots/)[^.]*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/join/:token",
      "headers": [{ "key": "Vary", "value": "Accept-Language" }]
    }
  ]
}
