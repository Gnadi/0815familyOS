{
  "name": "faos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build && node scripts/emit-app-shell.mjs",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project faos-rules-test \"vitest run tests/rules\"",
    "test:all": "npm run test && npm run test:rules"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "date-fns": "^3.6.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.13.6"
    },
    "basic-ftp": "^6.2.3",
    "firebase-tools": {
      "chokidar": "^4.0.3"
    }
  }
}
