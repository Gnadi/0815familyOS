{
  "name": "faos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build && node scripts/emit-app-shell.mjs",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project faos-rules-test \"vitest run tests/rules\"",
    "test:all": "npm run test && npm run test:rules && npm run test:integration",
    "test:integration": "node functions/sync-shared.mjs && firebase emulators:exec --only firestore --project faos-rules-test \"vitest run tests/integration\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "date-fns": "^3.6.0",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/forms": "^0.5.9",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.30.2",
    "http_ece": "^1.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "web-push": "^3.6.7"
  }
}
